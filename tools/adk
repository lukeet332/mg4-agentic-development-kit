def add_common(p, suppress=False, skip=()):
    def dflt(value):
        return argparse.SUPPRESS if suppress else value

    p.add_argument("--url", metavar="URL", default=dflt(None),
                   help="ADK base URL (env ADK_URL; default %s)" % DEFAULT_URL)
    p.add_argument("--token", metavar="TOKEN", default=dflt(None),
                   help="API token (env ADK_TOKEN; else ~/.adk/token)")
    if "timeout" not in skip:
        p.add_argument("--timeout", metavar="SECONDS", type=float, default=dflt(None),
                       help="per-request timeout in seconds (default %g; streaming needs more)"
                            % DEFAULT_TIMEOUT)
    p.add_argument("--quiet", action="store_true", default=dflt(False),
                   help="suppress informational messages on stderr")


