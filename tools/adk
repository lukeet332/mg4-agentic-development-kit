            "\"extras\":{\"k\":\"v\"}}'\n"
            "  adk intent action=force-stop package=com.example.app")
    p.add_argument("args", nargs="*", metavar="JSON|key=value")

    p = new("forward", "TCP forward rules on the car (adb forward / reverse)")
    fs = p.add_subparsers(dest="action", metavar="ACTION")
    fs.required = True
    fa = fs.add_parser("add", help="add a rule")
    fa.add_argument("--bind", default="0.0.0.0",
