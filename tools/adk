#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""adk - command line driver for the Agentic Development Kit (ADK) car head unit app.

ADK is a platform-signed system app on an MG4 head unit that serves an HTTP control
API (default port 8787) over the car hotspot or home Wi-Fi.  This CLI is the agent's
steering wheel: every endpoint of the API is reachable through `adk call`, and the
common ones have a verb of their own.

    adb forward tcp:8787 tcp:8787      # on the rig, then the default URL just works
    adk pair 123456 --name mac-agent   # code shown on the car screen
    adk health
    adk exec id
    adk install app-release.apk && adk logs --grep FATAL
    adk shot /tmp/car.png && adk ui

Everything is token authenticated.  The token comes from --token, $ADK_TOKEN or
~/.adk/token (written by `adk pair`).  Non-2xx responses exit 1 and print the status
and body to stderr; usage/config problems exit 2.
"""

import argparse
import json
import os
import re
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

VERSION = "0.1.0"
DEFAULT_URL = "http://127.0.0.1:8787"
DEFAULT_TIMEOUT = 60.0
TOKEN_DIR = os.path.join(os.path.expanduser("~"), ".adk")
TOKEN_FILE = os.path.join(TOKEN_DIR, "token")
MASTER_MIRROR = "/data/local/tmp/adk.token"

EXIT_OK = 0
EXIT_REMOTE = 1
EXIT_USAGE = 2

PAIR_HINT = (
    "adk: this endpoint needs a token.\n"
    "adk:   - the car app shows a 6-digit code:  adk pair <code>\n"
    "adk:   - or read the master token over adb: adb shell cat " + MASTER_MIRROR + "\n"
    "adk:     then:                              adk use <token>\n"
)

# --------------------------------------------------------------------- tiny utils


def die(message, code=EXIT_USAGE):
    """Print a fatal message to stderr and exit."""
    sys.stderr.write(message.rstrip("\n") + "\n")
    raise SystemExit(code)


def info(ctx, message):
    """Informational line on stderr, silenced by --quiet."""
    if not ctx.quiet:
        sys.stderr.write(message.rstrip("\n") + "\n")


def try_json(text):
    """Parse text as JSON if it plausibly is JSON, else None."""
    s = text.strip()
    if not s or s[0] not in "{[":
        return None
    try:
        return json.loads(s)
    except ValueError:
        return None


def print_json(obj):
    sys.stdout.write(json.dumps(obj, indent=2, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def print_text(text):
    if text and not text.endswith("\n"):
        text += "\n"
    sys.stdout.write(text)
    sys.stdout.flush()


def looks_binary(data):
    if b"\x00" in data[:8192]:
        return True
    try:
        data[:8192].decode("utf-8")
        return False
    except UnicodeDecodeError:
        return True


BINARY_PREFIXES = ("image/", "video/", "audio/")
BINARY_TYPES = (
    "application/octet-stream",
    "application/zip",
    "application/vnd.android.package-archive",
)


def is_binary_ct(content_type):
    ct = (content_type or "").split(";")[0].strip().lower()
    if not ct:
        return None
    if ct.startswith("text/"):
        return False
    if ct in ("application/json", "application/xml", "application/javascript"):
        return False
    if ct.endswith("+json") or ct.endswith("+xml"):
        return False
    if ct.startswith(BINARY_PREFIXES) or ct in BINARY_TYPES:
        return True
    return False


def suffix_for(content_type):
    ct = (content_type or "").split(";")[0].strip().lower()
    return {
        "image/png": ".png",
        "image/jpeg": ".jpg",
        "image/webp": ".webp",
        "video/mp4": ".mp4",
        "application/zip": ".zip",
    }.get(ct, ".bin")


def write_bytes(path, data):
    with open(path, "wb") as fh:
        fh.write(data)
    return len(data)


# ------------------------------------------------------------------ token store


def read_stored_token():
    try:
        with open(TOKEN_FILE, "r") as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def save_token(token):
    token = token.strip()
    if not token:
        die("adk: refusing to store an empty token", EXIT_USAGE)
    try:
        os.makedirs(TOKEN_DIR, mode=0o700, exist_ok=True)
        fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(token + "\n")
        os.chmod(TOKEN_FILE, 0o600)
    except OSError as exc:
        die("adk: cannot write %s: %s" % (TOKEN_FILE, exc), EXIT_USAGE)
    return TOKEN_FILE


def resolve_token(cli_token):
    """Return (token, source) with source naming where the token came from."""
    if cli_token:
        return cli_token.strip(), "--token"
    env = os.environ.get("ADK_TOKEN")
    if env and env.strip():
        return env.strip(), "ADK_TOKEN"
    stored = read_stored_token()
    if stored:
        return stored, TOKEN_FILE
    return None, None


def normalize_url(url):
    url = (url or "").strip() or DEFAULT_URL
    if not re.match(r"^https?://", url, re.I):
        url = "http://" + url
    return url.rstrip("/")


# ------------------------------------------------------------------ http layer


class Ctx(object):
    def __init__(self, url, token, token_source, timeout, quiet):
        self.url = url
        self.token = token
        self.token_source = token_source
        self.timeout = timeout if timeout else DEFAULT_TIMEOUT
        self.quiet = quiet

    def headers(self, token_required=True, extra=None):
        hdrs = {"Accept": "*/*", "User-Agent": "adk-cli/" + VERSION}
        if token_required:
            if not self.token:
                sys.stderr.write(PAIR_HINT)
                raise SystemExit(EXIT_USAGE)
            hdrs["X-ADK-Token"] = self.token
        if extra:
            hdrs.update(extra)
        return hdrs


class Response(object):
    __slots__ = ("status", "headers", "data", "url", "content_type")

    def __init__(self, status, headers, data, url):
        self.status = status
        self.headers = headers
        self.data = data
        self.url = url
        self.content_type = headers.get("Content-Type", "") or ""


def build_url(base, path, params=None):
    url = base.rstrip("/") + path
    if params:
        clean = [(k, v) for k, v in params.items() if v is not None]
        if clean:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(clean, doseq=True)
    return url


def fail_http(method, url, code, reason, payload):
    text = payload.decode("utf-8", "replace").strip()
    if len(text) > 2000:
        text = text[:2000] + "\n... (truncated)"
    sys.stderr.write("adk: HTTP %s %s - %s %s\n" % (code, reason, method, url))
    if text:
        sys.stderr.write(text + "\n")
    if code == 401:
        sys.stderr.write(PAIR_HINT)
    raise SystemExit(EXIT_REMOTE)


def fail_net(url, err):
    reason = getattr(err, "reason", err)
    sys.stderr.write("adk: cannot reach ADK at %s\n" % url)
    sys.stderr.write("adk: %s\n" % (reason,))
    if isinstance(reason, ConnectionRefusedError) or "refused" in str(reason).lower():
        sys.stderr.write("adk: connection refused - the HTTP channel is stopped, "
                         "or the port/host is wrong.\n")
    sys.stderr.write(
        "adk: hints:\n"
        "adk:   rig:  adb forward tcp:8787 tcp:8787   (then the default URL works)\n"
        "adk:   car:  adk --url http://<car-ip>:8787 health   (car hotspot or home Wi-Fi)\n"
        "adk:   check the ADK app is running and the HTTP channel is started\n"
    )
    raise SystemExit(EXIT_REMOTE)


def open_url(ctx, method, path, params=None, body=None, raw=None, timeout=None,
             token_required=True):
    """Build and send one request; returns the live http.client response object."""
    url = build_url(ctx.url, path, params)
    data = None
    extra = {}
    if raw is not None:
        data = raw
        extra["Content-Type"] = "application/octet-stream"
        if isinstance(raw, (bytes, bytearray)):
            extra["Content-Length"] = str(len(raw))
        else:
            try:
                pos = raw.tell()
                raw.seek(0, os.SEEK_END)
                extra["Content-Length"] = str(raw.tell() - pos)
                raw.seek(pos)
            except (OSError, ValueError):
                pass
    elif body is not None:
        data = json.dumps(body).encode("utf-8")
        extra["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, method=method,
                                 headers=ctx.headers(token_required, extra))
    t = timeout if timeout is not None else ctx.timeout
    try:
        return urllib.request.urlopen(req, timeout=t), url
    except urllib.error.HTTPError as exc:
        payload = b""
        try:
            payload = exc.read(65536)
        except Exception:
            pass
        fail_http(method, url, exc.code, exc.reason, payload)
    except urllib.error.URLError as exc:
        fail_net(url, exc)
    except (TimeoutError, OSError) as exc:
        fail_net(url, exc)


def http_request(ctx, method, path, params=None, body=None, raw=None, timeout=None,
                 token_required=True):
    resp, url = open_url(ctx, method, path, params, body, raw, timeout, token_required)
    with resp:
        payload = resp.read()
        return Response(resp.status, dict(resp.headers), payload, url)


def stream_request(ctx, path, params=None, timeout=None, token_required=True):
    """GET a streaming response and copy it to stdout as it arrives."""
    resp, _url = open_url(ctx, "GET", path, params=params, timeout=timeout,
                          token_required=token_required)
    try:
        with resp:
            while True:
                chunk = resp.read(8192)
                if not chunk:
                    break
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
    except KeyboardInterrupt:
        sys.stderr.write("\n")
    except (BrokenPipeError, ConnectionResetError):
        pass
    return EXIT_OK


# ------------------------------------------------------------------ api helpers


def api_json(ctx, method, path, params=None, body=None, raw=None, token_required=True,
             timeout=None, what=None):
    """Send a request and return the decoded JSON body (dies if it is not JSON)."""
    resp = http_request(ctx, method, path, params=params, body=body, raw=raw,
                        token_required=token_required, timeout=timeout)
    text = resp.data.decode("utf-8", "replace")
    obj = try_json(text)
    if obj is None:
        label = what or ("%s %s" % (method, path))
        die("adk: %s did not return JSON (HTTP %s):\n%s"
            % (label, resp.status, text.strip()[:1000]), EXIT_REMOTE)
    return obj


def show_json(obj, exit_on_false=True):
    """Pretty-print a JSON response; return False when the remote reported ok=false."""
    print_json(obj)
    if exit_on_false and isinstance(obj, dict) and obj.get("ok") is False:
        return False
    return True


def emit(ctx, resp, out_path=None, force_binary=None, raw_text=False):
    """Print or save a response according to its type."""
    ct = resp.content_type
    if force_binary is None:
        binary = is_binary_ct(ct)
        if binary is None:
            binary = looks_binary(resp.data)
    else:
        binary = force_binary

    if out_path:
        n = write_bytes(out_path, resp.data)
        info(ctx, "adk: wrote %s (%d bytes)" % (out_path, n))
        return EXIT_OK
    if binary:
        fd, path = tempfile.mkstemp(prefix="adk-", suffix=suffix_for(ct))
        with os.fdopen(fd, "wb") as fh:
            fh.write(resp.data)
        print(path)
        return EXIT_OK
    text = resp.data.decode("utf-8", "replace")
    if raw_text:
        print_text(text)
        return EXIT_OK
    obj = try_json(text)
    if obj is not None:
        print_json(obj)
    else:
        print_text(text)
    return EXIT_OK


# --------------------------------------------------------------- endpoint index


def fetch_help(ctx):
    obj = api_json(ctx, "GET", "/help", what="GET /help")
    eps = obj.get("endpoints")
    if not isinstance(eps, list):
        die("adk: GET /help returned no endpoint list", EXIT_REMOTE)
    return obj, eps


def match_endpoint(eps, target):
    t = (target or "").strip()
    if not t:
        die("adk: call needs an operation_id or \"METHOD /path\"", EXIT_USAGE)
    low = t.lower()
    for ep in eps:
        if str(ep.get("operation_id", "")).lower() == low:
            return ep
    m = re.match(r"^([A-Za-z]+)\s+(\S+)$", t)
    if m:
        method, path = m.group(1).upper(), m.group(2)
        for ep in eps:
            if str(ep.get("method", "")).upper() == method and ep.get("path") == path:
                return ep
        die("adk: no endpoint %s %s; run `adk endpoints` for the live list"
            % (method, path), EXIT_USAGE)
    cands = [ep for ep in eps
             if ep.get("path") == t or str(ep.get("path", "")).rstrip("/") == t.rstrip("/")]
    if len(cands) == 1:
        return cands[0]
    if len(cands) > 1:
        die("adk: %s matches several endpoints (%s); use \"METHOD /path\""
            % (t, ", ".join(sorted(str(c.get("method")) for c in cands))), EXIT_USAGE)
    cands = [ep for ep in eps if low in str(ep.get("operation_id", "")).lower()]
    if len(cands) == 1:
        return cands[0]
    die("adk: no endpoint matches %r; run `adk endpoints` (or `adk endpoints --json`)"
        % t, EXIT_USAGE)


def coerce_value(value, ptype):
    ptype = (ptype or "string").lower()
    if ptype == "int":
        try:
            return int(value)
        except ValueError:
            die("adk: expected an int, got %r" % value, EXIT_USAGE)
    if ptype == "double":
        try:
            return float(value)
        except ValueError:
            die("adk: expected a number, got %r" % value, EXIT_USAGE)
    if ptype == "bool":
        low = value.strip().lower()
        if low in ("1", "true", "yes", "on"):
            return True
        if low in ("0", "false", "no", "off"):
            return False
        die("adk: expected a bool (1/0/true/false), got %r" % value, EXIT_USAGE)
    if ptype == "json":
        try:
            return json.loads(value)
        except ValueError:
            die("adk: expected JSON, got %r" % value, EXIT_USAGE)
    return value


def guess_value(value):
    """Type guess for keys the endpoint table does not declare."""
    low = value.strip().lower()
    if low in ("true", "false"):
        return low == "true"
    if re.match(r"^-?\d+$", value.strip()):
        return int(value.strip())
    if value.strip()[:1] in "{[":
        try:
            return json.loads(value)
        except ValueError:
            return value
    return value


# -------------------------------------------------------------------- commands


def cmd_pair(args, ctx):
    body = {"code": args.code}
    if args.name:
        body["name"] = args.name
    obj = api_json(ctx, "POST", "/pair", body=body, token_required=False, what="POST /pair")
    if not obj.get("ok"):
        print_json(obj)
        return EXIT_REMOTE
    token = obj.get("token")
    if not token:
        die("adk: POST /pair returned no token: %s" % json.dumps(obj), EXIT_REMOTE)
    path = save_token(token)
    print("client_id: %s" % obj.get("client_id", ""))
    info(ctx, "adk: paired as %r; token saved to %s (mode 600)"
         % (obj.get("name", args.name or ""), path))
    return EXIT_OK


def cmd_token(args, ctx):
    if not ctx.token:
        sys.stderr.write(PAIR_HINT)
        return EXIT_USAGE
    source = ctx.token_source or "?"
    if args.show:
        print("source: %s" % source)
        print("token:  %s" % ctx.token)
    else:
        print("source: %s" % source)
        print("token:  %s... (%d chars, use --show for the full value)"
              % (ctx.token[:8], len(ctx.token)))
    return EXIT_OK


def cmd_use(args, ctx):
    path = save_token(args.token_value)
    print("token saved to %s (mode 600)" % path)
    return EXIT_OK


def cmd_endpoints(args, ctx):
    _obj, eps = fetch_help(ctx)
    if args.json:
        print_json(eps)
        return EXIT_OK
    rows = []
    for ep in eps:
        rows.append((
            str(ep.get("operation_id", "")),
            str(ep.get("method", "")),
            str(ep.get("path", "")),
            str(ep.get("summary", "")),
        ))
    headers = ("OPERATION_ID", "METHOD", "PATH", "SUMMARY")
    w_id = max([len(headers[0])] + [len(r[0]) for r in rows]) if rows else len(headers[0])
    w_m = max([len(headers[1])] + [len(r[1]) for r in rows]) if rows else len(headers[1])
    w_p = max([len(headers[2])] + [len(r[2]) for r in rows]) if rows else len(headers[2])
    try:
        width = int(os.environ.get("COLUMNS", "") or 0)
    except ValueError:
        width = 0
    if width <= 0:
        width = 120
    w_s = max(20, width - (w_id + w_m + w_p + 6))
    print("%-*s  %-*s  %-*s  %s" % (w_id, headers[0], w_m, headers[1],
                                    w_p, headers[2], headers[3]))
    for op_id, method, path, summary in rows:
        if len(summary) > w_s:
            summary = summary[:w_s - 1] + "~"
        print("%-*s  %-*s  %-*s  %s" % (w_id, op_id, w_m, method, w_p, path, summary))
    info(ctx, "adk: %d endpoints; run one with `adk call <operation_id> key=value ...`"
         % len(rows))
    return EXIT_OK


def cmd_call(args, ctx):
    _obj, eps = fetch_help(ctx)
    ep = match_endpoint(eps, args.target)
    method = str(ep.get("method", "GET")).upper()
    path = str(ep.get("path", ""))
    declared = {}
    raw_needed = False
    for p in ep.get("parameters", []) or []:
        declared[(str(p.get("in", "")), str(p.get("name", "")))] = p
        if p.get("in") == "body" and p.get("type") == "file":
            raw_needed = True

    if args.json_body is not None:
        try:
            extra = json.loads(args.json_body)
        except ValueError as exc:
            die("adk: --json is not valid JSON: %s" % exc, EXIT_USAGE)
        if not isinstance(extra, dict):
            die("adk: --json must be a JSON object", EXIT_USAGE)
    else:
        extra = {}

    query = {}
    body = {}
    if method == "GET":
        for key, value in extra.items():
            query[key] = value if isinstance(value, str) else json.dumps(value)
    else:
        body.update(extra)

    for pair in args.params:
        if "=" not in pair:
            die("adk: expected key=value, got %r" % pair, EXIT_USAGE)
        key, value = pair.split("=", 1)
        spec = declared.get(("body", key))
        if method == "GET" or (spec is None and declared.get(("query", key)) is not None):
            query[key] = value
        elif spec is not None:
            body[key] = coerce_value(value, spec.get("type"))
        else:
            body[key] = guess_value(value)

    if args.file:
        if method == "GET":
            die("adk: --file only makes sense for POST endpoints", EXIT_USAGE)
        if not os.path.isfile(args.file):
            die("adk: no such file: %s" % args.file, EXIT_USAGE)
        with open(args.file, "rb") as fh:
            resp = http_request(ctx, method, path, params=query, raw=fh, timeout=ctx.timeout)
    else:
        if raw_needed and not body:
            die("adk: %s takes a raw body; pass --file PATH" % ep.get("operation_id"), EXIT_USAGE)
        resp = http_request(ctx, method, path, params=query or None,
                            body=(body if method != "GET" else None))

    returns = str(ep.get("returns", "json")).lower()
    force_binary = None
    raw_text = False
    if returns in ("image/png", "image/jpeg", "video/mp4", "binary"):
        force_binary = True
    elif returns == "text":
        raw_text = True
    return emit(ctx, resp, out_path=args.out, force_binary=force_binary, raw_text=raw_text)


def cmd_health(args, ctx):
    obj = api_json(ctx, "GET", "/health", token_required=False, what="GET /health")
    return EXIT_OK if show_json(obj) else EXIT_REMOTE


def cmd_state(args, ctx):
    return EXIT_OK if show_json(api_json(ctx, "GET", "/state")) else EXIT_REMOTE


def cmd_version(args, ctx):
    return EXIT_OK if show_json(api_json(ctx, "GET", "/version")) else EXIT_REMOTE


def cmd_exec(args, ctx):
    command = " ".join(args.command)
    timeout = ctx.timeout
    body = {"cmd": command, "timeout_ms": int(min(timeout, 600) * 1000)}
    obj = api_json(ctx, "POST", "/exec", body=body, timeout=timeout + 10, what="POST /exec")
    out = obj.get("stdout") or ""
    err = obj.get("stderr") or ""
    if out:
        sys.stdout.write(out)
        sys.stdout.flush()
    if err:
        sys.stderr.write(err)
        sys.stderr.flush()
    if obj.get("timeout"):
        info(ctx, "adk: command timed out after %sms" % obj.get("ms"))
    try:
        return int(obj.get("exit", 0))
    except (TypeError, ValueError):
        return EXIT_REMOTE


def stdin_ready(timeout):
    """True when a line can be read from stdin without blocking."""
    try:
        import select
        ready, _w, _x = select.select([sys.stdin], [], [], timeout)
        return bool(ready)
    except Exception:
        return True


def cmd_sh(args, ctx):
    opened = api_json(ctx, "GET", "/shell/open", what="GET /shell/open")
    sid = opened.get("session_id") or opened.get("sid")
    if not sid:
        die("adk: /shell/open returned no session id: %s" % json.dumps(opened), EXIT_REMOTE)
    interactive = sys.stdin.isatty()
    offset = 0
    eof = False
    quiet_polls = 0
    status = EXIT_OK
    info(ctx, "adk: shell session %s (Ctrl-D closes it)" % sid)
    try:
        while True:
            obj = api_json(ctx, "GET", "/shell/read",
                           params={"sid": sid, "offset": offset,
                                   "wait_ms": 0 if interactive else 1500},
                           what="GET /shell/read")
            data = obj.get("data") or ""
            offset = obj.get("offset", offset)
            if data:
                sys.stdout.write(data)
                sys.stdout.flush()
                quiet_polls = 0
            else:
                quiet_polls += 1
            if not obj.get("alive", True):
                try:
                    status = int(obj.get("exit") or 0)
                except (TypeError, ValueError):
                    status = EXIT_OK
                break
            if eof and quiet_polls >= 2:
                break
            if not eof:
                if not stdin_ready(0.25 if interactive else 0.05):
                    continue
                line = sys.stdin.readline()
                if line == "":
                    eof = True
                    continue
                api_json(ctx, "POST", "/shell/write", params={"sid": sid},
                         body={"sid": sid, "data": line.rstrip("\r\n")},
                         what="POST /shell/write")
    except KeyboardInterrupt:
        sys.stderr.write("\n")
    finally:
        try:
            api_json(ctx, "GET", "/shell/close", params={"sid": sid}, what="GET /shell/close")
        except (SystemExit, Exception):
            pass
    info(ctx, "adk: session closed")
    return status


def cmd_install(args, ctx):
    if not os.path.isfile(args.apk):
        die("adk: no such APK: %s" % args.apk, EXIT_USAGE)
    params = {
        "replace": "1",
        "downgrade": "0" if args.no_downgrade else "1",
        "grant": "0" if args.no_grant else "1",
        "user": str(args.user),
    }
    timeout = max(ctx.timeout, 300.0)
    with open(args.apk, "rb") as fh:
        obj = api_json(ctx, "POST", "/install", params=params, raw=fh, timeout=timeout,
