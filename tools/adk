    p.add_argument("apk", metavar="APK", help="new ADK .apk")

    p = new("confirm", "cancel the pending self-update rollback")
    p = new("rollback", "immediately reinstall the last-known-good ADK build")
    p = new("reboot", "reboot the head unit")
    p.add_argument("--mode", metavar="M", default="", help="empty, recovery or bootloader")

    return parser


def main(argv=None):
    parser = build_parser()
    args, extras = parser.parse_known_args(argv)
    if extras:
        if args.cmd == "exec":
            args.command.extend(extras)
        elif args.cmd == "call" and all("=" in e for e in extras):
            # argparse cannot interleave nargs="*" with flags, so `call op --file x k=v`
            # leaves the trailing key=value pairs over; they belong to the call.
            args.params.extend(extras)
        else:
            parser.error("unrecognized arguments: %s" % " ".join(extras))
    if not getattr(args, "cmd", None):
        parser.print_help(sys.stderr)
        return EXIT_USAGE

    token, source = resolve_token(args.token)
    ctx = Ctx(normalize_url(args.url or os.environ.get("ADK_URL") or DEFAULT_URL),
              token, source, args.timeout, args.quiet)
    handler = HANDLERS[args.cmd]
    return handler(args, ctx)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stderr.write("\nadk: interrupted\n")
        sys.exit(130)
    except BrokenPipeError:
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except OSError:
            pass
        sys.exit(EXIT_OK)
