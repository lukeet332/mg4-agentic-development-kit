def build_intent_body(argv):
    if len(argv) == 1 and argv[0].lstrip().startswith("{"):
        try:
            obj = json.loads(argv[0])
        except ValueError as exc:
            die("adk: intent JSON is invalid: %s" % exc, EXIT_USAGE)
        if not isinstance(obj, dict):
            die("adk: intent JSON must be an object", EXIT_USAGE)
        return obj
    body = {}
    for pair in argv:
        if "=" not in pair:
            die("adk: intent takes a JSON object or key=value pairs, got %r" % pair,
                EXIT_USAGE)
        key, value = pair.split("=", 1)
        if key in ("extras", "extras_int", "extras_bool", "flags"):
            try:
                body[key] = json.loads(value)
            except ValueError:
                die("adk: intent %s must be JSON, got %r" % (key, value), EXIT_USAGE)
        elif key == "user":
            body[key] = coerce_value(value, "int")
        else:
            body[key] = value
    return body


def cmd_intent(args, ctx):
    body = build_intent_body(args.args)
    if not body:
        die("adk: intent needs a JSON body or key=value pairs", EXIT_USAGE)
    obj = api_json(ctx, "POST", "/intent", body=body, what="POST /intent")
    return EXIT_OK if show_json(obj) else EXIT_REMOTE


